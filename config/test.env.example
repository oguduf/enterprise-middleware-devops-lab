# Copy to a protected, local test.env file and replace every placeholder.
# Do not commit real endpoints, paths to credentials, or credentials.
DEPLOY_ENV=TEST
APP_NAME=middleware-demo
HEALTH_URL=https://REPLACE_WITH_TEST_APP_HOST/middleware-demo/health
HEALTH_TIMEOUT_SECONDS=5
HEALTH_INTERVAL_SECONDS=5
HEALTH_ATTEMPTS=12
DEPLOY_TIMEOUT_SECONDS=600
LOG_DIR=./logs

# WebLogic 14.1.1 test AdminServer and target; values are intentionally placeholders.
WEBLOGIC_ADMIN_URL=t3s://REPLACE_WITH_TEST_ADMIN_HOST:REPLACE_WITH_ADMIN_PORT
WEBLOGIC_TARGETS=REPLACE_WITH_TEST_MANAGED_SERVER_OR_CLUSTER
WEBLOGIC_USER_CONFIG_FILE=/secure/path/to/test/weblogic-user.config
WEBLOGIC_USER_KEY_FILE=/secure/path/to/test/weblogic-user.key
WEBLOGIC_CLASSPATH=/REPLACE_WITH_WEBLOGIC_HOME/wlserver/server/lib/weblogic.jar
WEBLOGIC_ACTION=deploy

# JBoss EAP 7.4 test management endpoint and external Elytron client config.
JBOSS_HOME=/REPLACE_WITH_JBOSS_EAP_HOME
JBOSS_CONTROLLER=remote+https://REPLACE_WITH_TEST_JBOSS_HOST:REPLACE_WITH_MANAGEMENT_PORT
JBOSS_MODE=standalone
JBOSS_WILDFLY_CONFIG=/secure/path/to/test/wildfly-config.xml
JBOSS_RUNTIME_NAME=middleware-demo.war
# For domain mode, set JBOSS_MODE=domain and add e.g. JBOSS_SERVER_GROUPS=REPLACE_WITH_TEST_GROUP.
